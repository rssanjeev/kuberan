	"item": [
		{
			"name": "Upload Credit Card Statement",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "file",
							"type": "file",
							"src": [],
							"description": "PDF file of credit card statement (Chase supported)"
						}
					]
				},
				"url": {
					"raw": "http://localhost:8000/financier/upload",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"financier",
						"upload"
					]
				},
				"description": "Upload and process a single credit card statement PDF. Currently supports Chase credit card statements.\n\n**Security**: File is processed in-memory, data saved to database, then file is deleted. No PDFs are stored.\n\n**Response**: Returns processing status, file hash, transaction count, totals, and categories found."
			},
			"response": [
				{
					"name": "Success Example",
					"originalRequest": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "May25.pdf"
								}
							]
						},
						"url": {
							"raw": "http://localhost:8000/financier/upload",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8000",
							"path": [
								"financier",
								"upload"
							]
						}
					},
					"status": "OK",
					"code": 200,
					"_postman_previewlanguage": "json",
					"header": [
						{
							"key": "Content-Type",
							"value": "application/json"
						}
					],
					"body": "{\n    \"status\": \"success\",\n    \"message\": \"Document processed successfully\",\n    \"file_hash\": \"abc123def456...\",\n    \"transaction_count\": 42,\n    \"total_charges\": 1010.70,\n    \"total_credits\": -2036.97,\n    \"categories_found\": [\"Groceries\", \"Coffee & Cafes\", \"Restaurants & Dining\"]\n}"
				}
			]
		},
		{
			"name": "Upload Multiple Credit Card Statements (Batch)",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "files",
							"type": "file",
							"src": [],
							"description": "Select multiple PDF files"
						}
					]
				},
				"url": {
					"raw": "http://localhost:8000/financier/upload/batch?bank=Chase",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"financier",
						"upload",
						"batch"
					],
					"query": [
						{
							"key": "bank",
							"value": "Chase",
							"description": "Bank name"
						}
					]
				},
				"description": "Upload and process multiple credit card statement PDFs in a single request.\n\n**Security**: All files are processed in-memory, data saved to database, then files are deleted. No PDFs are stored.\n\n**Response**: Returns summary with individual results for each file (successful and failed)."
			},
			"response": [
				{
					"name": "Success Example",
					"originalRequest": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "files",
									"type": "file",
									"src": ["May25.pdf", "Jun25.pdf", "Jul25.pdf"]
								}
							]
						},
						"url": {
							"raw": "http://localhost:8000/financier/upload/batch",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8000",
							"path": [
								"financier",
								"upload",
								"batch"
							]
						}
					},
					"status": "OK",
					"code": 200,
					"_postman_previewlanguage": "json",
					"header": [
						{
							"key": "Content-Type",
							"value": "application/json"
						}
					],
					"body": "{\n    \"total_files\": 3,\n    \"successful\": 3,\n    \"failed\": 0,\n    \"results\": [\n        {\n            \"filename\": \"May25.pdf\",\n            \"status\": \"success\",\n            \"data\": {\n                \"status\": \"success\",\n                \"transaction_count\": 42,\n                \"total_charges\": 1010.70\n            }\n        },\n        {\n            \"filename\": \"Jun25.pdf\",\n            \"status\": \"success\",\n            \"data\": {\n                \"status\": \"success\",\n                \"transaction_count\": 68,\n                \"total_charges\": 1066.02\n            }\n        }\n    ],\n    \"errors\": null\n}"
				}
			]
		},
