					"item": [
						{
							"name": "Login",
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/x-www-form-urlencoded"
									}
								],
								"body": {
									"mode": "urlencoded",
									"urlencoded": [
										{
											"key": "username",
											"value": "testuser",
											"type": "text"
										},
										{
											"key": "password",
											"value": "password123",
											"type": "text"
										}
									]
								},
								"url": {
									"raw": "{{baseUrl}}/token",
									"host": ["{{baseUrl}}"],
									"path": ["token"]
								},
								"description": "Login and receive access token for authenticated endpoints"
							},
							"response": []
						},
