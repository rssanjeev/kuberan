									]
								},
								"url": {
									"raw": "{{baseUrl}}/financier/upload/batch?bank=Chase",
									"host": ["{{baseUrl}}"],
									"path": ["financier", "upload", "batch"],
									"query": [
										{
											"key": "bank",
											"value": "Chase",
											"description": "Bank name"
										}
									]
								},
								"description": "Upload and process multiple credit card statement PDFs in a single request. All files are processed in-memory only, never stored."
