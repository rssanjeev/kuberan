# Example environment variables for Kuberan
# Copy this to .env and fill in your actual values

# FRONTEND
API_URL=http://localhost:8000

# BACKEND
DATABASE_URL=sqlite:///./test.db
SECRET_KEY=your-secret-key-here

# Provider API Keys (Optional - for enhanced data)
# Get free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your-alpha-vantage-key-here

# Get free key at: https://finnhub.io/register
FINNHUB_KEY=your-finnhub-key-here
